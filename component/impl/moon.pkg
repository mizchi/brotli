import {
  "mizchi/brotli-component/gen/cabi" @cabi,
  "mizchi/brotli" @brotli,
}

options(
  "is-main": true,
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "exports": [
        "cabi_realloc:cabi_realloc",
        "wasmExportDecompress:mizchi:brotli/decompress#decompress",
        "wasmExportCompress:mizchi:brotli/compress#compress",
        "wasmExportCompressWithQuality:mizchi:brotli/compress#compress-with-quality",
      ],
    },
    "wasm-gc": {
      "export-memory-name": "memory",
      "exports": [
        "cabi_realloc:cabi_realloc",
        "wasmExportDecompress:mizchi:brotli/decompress#decompress",
        "wasmExportCompress:mizchi:brotli/compress#compress",
        "wasmExportCompressWithQuality:mizchi:brotli/compress#compress-with-quality",
      ],
    },
  },
)